NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/novax
JWT_ACCESS_SECRET=novax-dev-access-secret-change-me
JWT_REFRESH_SECRET=novax-dev-refresh-secret-change-me
COOKIE_SECRET=novax-dev-cookie-secret-change-me
CORS_ORIGIN=http://localhost:5173
MARKET_MODE=SIMULATED
MARKET_TICK_INTERVAL_MS=1000
MARKET_STARTING_PRICE=1.0000
SOCKET_PATH=/socket.io
LOG_LEVEL=debug
DEMO_FUNDING_ENABLED=true
INITIAL_CONVERSION_RATE=1.0
